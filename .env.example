# Copy to .env. Every value above the test heading is read and validated at backend startup; a
# missing or malformed one fails loudly, naming the variable.

# dev | test | prod — controls the Secure flag on the visitor cookie and log formatting
ENV=dev

# SQLAlchemy URL. The compose db listens on host port 5433 (5432 inside the network); inside
# docker-compose the backend service overrides this with the `db` host.
DATABASE_URL=postgresql+psycopg://breachscan:breachscan@localhost:5433/breachscan

# Browser origin allowed by CORS (the Vite dev server in dev, the frontend container in compose)
FRONTEND_ORIGIN=http://localhost:5173

# Sent as User-Agent on every HIBP call. HIBP requires a descriptive value that identifies the
# API consumer and answers 403 without one.
HIBP_USER_AGENT=breach-scan-funnel

# Required on PATCH /api/feature-flags/{key} as the X-Admin-Token header. Pasted into /admin per
# session; never shipped in the frontend build. Generate one: `openssl rand -hex 24`.
ADMIN_TOKEN=

# --- Tests only. Read by tests/integration/conftest.py, never by the app. ---

# The database the integration suite migrates and rolls back inside. `pnpm test:backend` needs it.
TEST_DATABASE_URL=postgresql+psycopg://breachscan:breachscan@localhost:5433/breachscan_test
