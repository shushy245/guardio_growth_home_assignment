# Copy to .env. Every value is read and validated at backend startup; a missing one fails loudly.

# dev | test | prod — controls the Secure flag on the visitor cookie and log formatting
ENV=dev

# SQLAlchemy URL. Inside docker-compose the backend service overrides the host to `db`.
DATABASE_URL=postgresql+psycopg://breachscan:breachscan@localhost:5432/breachscan
TEST_DATABASE_URL=postgresql+psycopg://breachscan:breachscan@localhost:5432/breachscan_test

# Browser origin allowed by CORS (the Vite dev server in dev, the frontend container in compose)
FRONTEND_ORIGIN=http://localhost:5173

# Required on feature-flag writes as the X-Admin-Token header. Generate your own; never commit a real one.
ADMIN_TOKEN=change-me

# HIBP asks every client to identify itself
HIBP_USER_AGENT=breach-scan-funnel-home-assignment
